                    <Qty>320.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><span>Tondachziegel eindecken</span></TextOutlTxt></OutlTxt></OutlineText>
                        <DetailTxt>
                          <Text>
                            <p><span>Falzziegel, naturrot, Deckung nach Herstellervorschrift.</span></p>
                            <p><span>Sturmklammern an Traufe, Ortgang und First. Material &amp; Montage einschließlich Verschnitt.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
