      <BoQBody>
        <BoQCtgy RNoPart="01" ID="ID10">
          <LblTx><p><span>Gerüst- und Vorarbeiten</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010" ID="ID11">
                <LumpSumItem>Yes</LumpSumItem>
                <Qty>1.000</Qty>
                <QU>psch</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><span>Baustelleneinrichtung</span></TextOutlTxt></OutlTxt></OutlineText>
                    <DetailTxt><Text><p><span>Einrichten und Räumen der Baustelle, Bereitstellung von Containern und Absperrungen.</span></p></Text></DetailTxt>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0020" ID="ID12">
                <Qty>280.000</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <OutlineText><OutlTxt><TextOutlTxt><span>Fassadengerüst stellen</span></TextOutlTxt></OutlTxt></OutlineText>
                    <DetailTxt><Text><p><span>Gerüst Lastklasse 3, inkl. Auf- und Abbau, Vorhaltung 8 Wochen.</span></p></Text></DetailTxt>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy RNoPart="02" ID="ID20">
          <LblTx><p><span>Dachdeckerarbeiten</span></p></LblTx>
          <BoQBody>
            <BoQCtgy RNoPart="01" ID="ID21">
              <LblTx><p><span>Steildach</span></p></LblTx>
              <BoQBody>
                <Itemlist>
                  <Item RNoPart="0010" ID="ID22">
                    <Qty>320.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><span>Alte Dacheindeckung abbrechen</span></TextOutlTxt></OutlTxt></OutlineText>
                        <DetailTxt><Text><p><span>Bestehende Betondachsteine einschl. Lattung abnehmen, sortieren und fachgerecht entsorgen.</span></p></Text></DetailTxt>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item RNoPart="0020" ID="ID23">
                    <Qty>320.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><span>Konterlattung und Lattung liefern und montieren</span></TextOutlTxt></OutlTxt></OutlineText>
                        <DetailTxt><Text><p><span>Konterlatte 30/50 mm, Dachlatte 40/60 mm, Nagelung nach Regelwerk.</span></p></Text></DetailTxt>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item RNoPart="0030" ID="ID24">
                    <Qty>320.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><span>Unterspannbahn diffusionsoffen verlegen</span></TextOutlTxt></OutlTxt></OutlineText>
