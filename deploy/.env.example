# Copy to .env and fill in. NEVER commit the real .env.

# Image names built by GitHub Actions (lower case): ghcr.io/<github-user>/meisterwerk
IMAGE_PREFIX=ghcr.io/volkerbtmerch/meisterwerk
IMAGE_TAG=latest

# Public address of the demo (used for CORS), no trailing slash
PUBLIC_URL=https://demo.example.com

# Host port the Synology reverse proxy forwards to
WEB_PORT=8085

# Secrets: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=
JWT_SECRET=

# Passwords of the demo accounts created by the seed (demo@meisterwerk.local, admin@meisterwerk.local ...).
# Leave empty only for a private test. For a public demo choose your own.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
