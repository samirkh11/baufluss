// Prisma schema for the Meisterwerk platform.
//
// Multi-tenancy model: every tenant is a "Company" (= one Handwerksbetrieb / craft business).
// All tenant-owned data carries a companyId foreign key. Tenant isolation is enforced in the
// application layer (every repository/service method is called with the authenticated user's
// companyId and filters by it) rather than via Postgres Row-Level Security. RLS can be added
// later as defense-in-depth once the schema for the remaining feature blocks (contacts, projects,
// quotes, invoices, ...) has landed — see /.claude/memory/project_roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role a user holds within their company. Kept as a small enum for now; move to a dedicated
// permissions table only if/when granular per-module permissions are actually needed.
enum CompanyRole {
  OWNER // Created the company account, can manage billing and delete the company.
  ADMIN // Full access to all modules within the company.
  MEMBER // Day-to-day user; module-level restrictions can be layered on top later.
}

// A tenant: one craft business using the platform.
model Company {
  id        String  @id @default(uuid())
  name      String
  legalForm String? // e.g. "GmbH", "Einzelunternehmen"

  // Address
  street  String?
  zipCode String?
  city    String?
  country String  @default("DE")

  // Tax / banking data required on German invoices and letterhead
  taxId String? // Steuernummer
  vatId String? // USt-IdNr.
  iban  String?
  bic   String?

  // Contact details shown on documents
  email   String?
  phone   String?
  website String?

  // Branding
  logoPath             String? // relative path under /uploads served statically by the API
  letterheadHeaderText String? @db.Text
  letterheadFooterText String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  numberSequences  NumberSequence[]
  contacts         Contact[]
  catalogItems     CatalogItem[]
  projects         Project[]
  reports          Report[]
  documents        Document[]
  payments         Payment[]
  dunnings         Dunning[]
  dunningSettings  DunningSettings?
  timeEntries      TimeEntry[]
  incomingInvoices IncomingInvoice[]

  @@map("companies")
}

// A person who can log into the platform, scoped to exactly one company.
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  role         CompanyRole @default(MEMBER)
  isActive     Boolean     @default(true)
  imagePath    String? // profile picture (single image), relative path under /uploads

  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  reports            Report[]
  timeEntries        TimeEntry[]

  // Internal hourly cost rate for project cost calculation. Only visible to OWNER/ADMIN.
  hourlyRate Decimal? @db.Decimal(8, 2)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  uploadedInvoices IncomingInvoice[] @relation("InvoiceUploader")
  approvedInvoices IncomingInvoice[] @relation("InvoiceApprover")
  dashboardLayout  DashboardLayout?

  @@index([companyId])
  @@map("users")
}

// Configurable numbering scheme ("Nummernkreis") for a document type, e.g. quotes or invoices.
// Only the configuration lives here for now; the counter is consumed once the corresponding
// document module (Angebote, Rechnungen, ...) is implemented.
model NumberSequence {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType  String // "QUOTE" | "ORDER" | "INVOICE" | "CREDIT_NOTE" | "REPORT" (free-form for now)
  prefix        String  @default("")
  nextNumber    Int     @default(1)
  digits        Int     @default(4) // zero-padding width, e.g. digits=4 -> "0007"
  resetYearly   Boolean @default(false)
  lastResetYear Int? // calendar year of the last yearly reset (only used when resetYearly)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentType])
  @@map("number_sequences")
}

// Business role(s) a contact plays. One contact may hold several (e.g. a supplier that is also a customer).
enum ContactType {
  CUSTOMER // Kunde
  SUPPLIER // Lieferant
  SUBCONTRACTOR // Subunternehmer
}

// Kind of catalog entry: a labour/service position or a physical article.
enum CatalogItemKind {
  SERVICE // Leistung
  ARTICLE // Artikel / Material
}

// Address book entry (customers, suppliers, subcontractors share one table because their fields
// are identical; the `types` array distinguishes the roles). Referenced by projects and documents
// in later blocks, which is why contacts are archived (isActive=false) rather than hard-deleted
// once documents exist (GoBD).
model Contact {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  types ContactType[]

  // Optional own customer/supplier number shown on documents.
  number String?

  // Organisation vs. private person
  isOrganization   Boolean @default(true)
  organizationName String? // set when isOrganization
  salutation       String? // Herr / Frau / Divers ...
  firstName        String?
  lastName         String?

  street  String?
  zipCode String?
  city    String?
  country String  @default("DE")

  email   String?
  phone   String?
  mobile  String?
  website String?

  // Tax / payment data (needed for invoices, §13b checks and incoming invoices)
  vatId           String?
  taxId           String?
  iban            String?
  bic             String?
  paymentTermDays Int? // default Zahlungsziel in Tagen

  projects  Project[] // projects this contact is the customer of
  documents Document[] // documents addressed to this contact

  notes     String? @db.Text
  imagePath String? // single picture/logo, relative path under /uploads
  isActive  Boolean @default(true)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  incomingInvoices IncomingInvoice[]

  @@unique([companyId, number])
  @@index([companyId])
  @@map("contacts")
}

// Service and article master data ("Leistungs- und Artikelstamm"). Quote/invoice positions copy
// values from here at creation time, so later price changes never alter existing documents.
model CatalogItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind        CatalogItemKind
  sku         String? // Artikel-/Leistungsnummer
  name        String
  description String?         @db.Text
  unit        String          @default("Stk") // Einheit: Stk, h, m, m², pauschal ...

  netPrice      Decimal  @db.Decimal(12, 2) // Verkaufspreis netto
  purchasePrice Decimal? @db.Decimal(12, 2) // Einkaufspreis netto (Kalkulation)
  vatRate       Decimal  @default(19) @db.Decimal(5, 2) // Prozent

  isActive Boolean @default(true)

  images        CatalogItemImage[]
  documentItems DocumentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, kind])
  @@map("catalog_items")
}

// Pictures of a service/article (several per item). Tenant ownership is derived via the item.
model CatalogItemImage {
  id            String      @id @default(uuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  path          String // relative path under /uploads
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([catalogItemId])
  @@map("catalog_item_images")
}

enum ProjectStatus {
  PLANNING // In Planung
  IN_PROGRESS // In Ausführung
  ON_HOLD // Pausiert
  COMPLETED // Abgeschlossen
  CANCELLED // Abgebrochen
}

enum ReportType {
  DAILY // Tagesbericht / Bautagebuch
  PROGRESS // Baufortschrittsbericht
  DEFECT // Mängelbericht
  ACCEPTANCE // Abnahmeprotokoll
  INCIDENT // Vorkommnis / Unfall / Behinderungsanzeige
  OTHER
}

// A construction job (Bauvorhaben). The hub that quotes, orders, invoices (later blocks) and
// reports hang off.
model Project {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String // generated from the PROJECT number sequence
  name        String
  status      ProjectStatus @default(PLANNING)
  description String?       @db.Text

  // Customer is optional (early leads), but a contact that is used by a project cannot be hard-deleted.
  customerId String?
  customer   Contact? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Building site address (differs from the customer's address in most cases)
  siteStreet  String?
  siteZipCode String?
  siteCity    String?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members          ProjectMember[]
  reports          Report[]
  documents        Document[]
  timeEntries      TimeEntry[]
  incomingInvoices IncomingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@map("projects")
}

// Employees assigned to a project (many-to-many).
model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// A report on a project (Bautagebuch, Mängelbericht, Abnahme, ...). Equal in rank to quotes and
// invoices: shown in the project overview next to the documents.
model Report {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number     String // generated from the REPORT number sequence
  type       ReportType @default(DAILY)
  title      String
  reportDate DateTime   @db.Date

  // Author reference plus a name snapshot, so the report stays attributable if the user is deleted.
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String

  weather         String? // free text, e.g. "sonnig, 18 °C"
  workPerformed   String? @db.Text // durchgeführte Arbeiten
  issues          String? @db.Text // Besonderheiten, Mängel, Behinderungen
  progressPercent Int? // 0-100

  photos ReportPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, reportDate])
  @@index([projectId])
  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  path      String // relative path under /uploads
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_photos")
}

enum DocumentType {
  QUOTE // Angebot
  ORDER // Auftragsbestätigung
  INVOICE // Rechnung
  CREDIT_NOTE // Gutschrift / Stornorechnung
}

// Lifecycle states. Only the quote states are used so far; order/invoice states (e.g. PAID,
// CANCELLED) are added with the blocks that need them.
enum DocumentStatus {
  DRAFT // editable, no number yet
  SENT // finalized: number assigned, content locked
  ACCEPTED
  REJECTED
  CANCELLED // invoices only: cancelled by a credit note (Storno); kept as a record
}

enum DocumentItemKind {
  POSITION // priced line
  HEADING // group title (Titel), numbered 1, 2, ...
  TEXT // free text line without price
}

// One table for all business documents (quote -> order -> invoice share the same structure, so
// converting one into the next is a copy, and PDF/GAEB/E-invoice logic is written once).
model Document {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Documents are legal records: a project that still has documents cannot be deleted.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  type   DocumentType
  status DocumentStatus @default(DRAFT)
  // Assigned from the number sequence when the document is finalized (drafts have none), so
  // numbers stay gap-free.
  number String?

  // Document this one was created from (quote -> order -> invoice chain).
  sourceDocumentId String?
  sourceDocument   Document?  @relation("DocumentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments Document[] @relation("DocumentSource")

  // Recipient: live reference plus an address snapshot that is frozen on finalization, so a later
  // change of the contact never alters an issued document.
  recipientContactId String?
  recipientContact   Contact? @relation(fields: [recipientContactId], references: [id], onDelete: Restrict)
  recipientName      String?
  recipientStreet    String?
  recipientZipCode   String?
  recipientCity      String?
  recipientCountry   String?

  subject      String? // Betreff
  introText    String?   @db.Text
  closingText  String?   @db.Text
  documentDate DateTime  @db.Date
  validUntil   DateTime? @db.Date // quotes: gültig bis
  currency     String    @default("EUR")

  // Totals are calculated server-side on every save (see documents/calculations.ts).
  netTotal   Decimal @default(0) @db.Decimal(14, 2)
  vatTotal   Decimal @default(0) @db.Decimal(14, 2)
  grossTotal Decimal @default(0) @db.Decimal(14, 2)

  finalizedAt DateTime?

  // Sender data (company name, address, tax ids, bank, letterhead) frozen when the document is
  // issued, so changing the company profile later never alters an issued document (GoBD).
  issuerSnapshot Json?

  items          DocumentItem[]  @relation("DocumentItems")
  invoiceDetails InvoiceDetails?
  payments       Payment[]
  dunnings       Dunning[]
  deductedIn     DocumentItem[]  @relation("DeductedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type, number])
  @@index([companyId, type, status])
  @@index([projectId])
  @@map("documents")
}

// A line of a document. Catalog values are COPIED here when the line is created, so later price
// changes in the catalog never alter existing documents.
model DocumentItem {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation("DocumentItems", fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder  Int

  kind DocumentItemKind @default(POSITION)

  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  // Original GAEB Ordnungszahl (OZ) of an imported line, e.g. "02.01.0030". Kept so a priced offer
  // exported as GAEB X84 refers to the same numbers as the bill of quantities we received.
  oz String?

  sku         String?
  name        String // Kurztext
  description String? @db.Text // Langtext

  quantity        Decimal @default(1) @db.Decimal(12, 3)
  unit            String  @default("Stk")
  unitPrice       Decimal @default(0) @db.Decimal(12, 2) // net
  vatRate         Decimal @default(19) @db.Decimal(5, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  // Optional (Alternativ-/Bedarfsposition): shown on the document but not part of the totals.
  isOptional      Boolean @default(false)

  // Final invoice only: this (negative) line deducts the partial invoice it points to.
  deductsDocumentId String?
  deductsDocument   Document? @relation("DeductedBy", fields: [deductsDocumentId], references: [id], onDelete: SetNull)

  lineTotal Decimal @default(0) @db.Decimal(14, 2) // net, after discount; 0 for non-positions

  @@index([documentId, sortOrder])
  @@map("document_items")
}

enum TimeEntryStatus {
  OPEN // can be corrected by the employee
  APPROVED // released by the office (e.g. for payroll); locked for the employee
}

// Working time of one employee on one day, optionally assigned to a project. Either a time range
// (start/end/break) or a plain duration. A running stopwatch is an entry with a start but no end.
// Times are minutes since midnight in the company time zone (Europe/Berlin).
model TimeEntry {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Working time records must be kept (ArbZG: 2 years), so an employee with entries cannot be
  // deleted, only deactivated.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // No project = internal time (workshop, office, travel).
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  date            DateTime @db.Date
  startMinute     Int?
  endMinute       Int? // null while the stopwatch is running
  breakMinutes    Int      @default(0)
  durationMinutes Int      @default(0) // net working time (0 while running)

  activity String? // what was done, e.g. "Latten montiert"
  note     String? @db.Text

  status       TimeEntryStatus @default(OPEN)
  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, date])
  @@index([userId, date])
  @@index([projectId])
  @@map("time_entries")
}

// Data that only invoices have (1:1 with Document). Kept out of Document so the quote/order paths
// stay simple; payments, dunning and partial-invoice data follow in their own tables.
// How an invoice relates to the contract (quote/order): a complete invoice, a partial invoice
// (Abschlagsrechnung, a share of the contract value) or the final invoice (Schlussrechnung), which
// bills the whole contract and deducts the partial invoices already issued.
enum InvoiceKind {
  STANDARD
  PARTIAL
  FINAL
}

model InvoiceDetails {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind          InvoiceKind @default(STANDARD)
  partialNumber Int? // running number of the partial invoice within its contract (1, 2, ...)

  // Sicherheitseinbehalt: the customer withholds a share of this invoice's gross amount until the
  // warranty period ends. The amount is fixed when the invoice is issued.
  retentionPercent Decimal?  @db.Decimal(5, 2)
  retentionAmount  Decimal?  @db.Decimal(14, 2)
  retentionDueDate DateTime? @db.Date // when the retention becomes payable (end of warranty)

  // Leistungsdatum / Leistungszeitraum (mandatory on every invoice, § 14 Abs. 4 Nr. 6 UStG)
  serviceDateFrom DateTime? @db.Date
  serviceDateTo   DateTime? @db.Date

  // Payment terms: due date = invoice date + paymentTermDays (fixed when the invoice is issued)
  paymentTermDays Int       @default(14)
  dueDate         DateTime? @db.Date

  // § 13b UStG: the recipient owes the VAT (construction services between contractors)
  reverseCharge  Boolean @default(false)
  recipientVatId String? // snapshot of the recipient's USt-IdNr. (required for § 13b)

  // Optional references printed on the invoice (also needed for e-invoices to public bodies)
  orderReference String? // Bestellnummer / Auftragsnummer des Kunden
  buyerReference String? // Leitweg-ID (XRechnung, public bodies)

  // Mahnsperre: no dunning letters while the invoice is disputed or a payment arrangement exists
  dunningBlocked     Boolean @default(false)
  dunningBlockReason String?

  @@map("invoice_details")
}

// What a payment settles: the payable amount of the invoice (gross minus retention) or the
// retention (Sicherheitseinbehalt), which is a separate receivable with its own due date.
enum PaymentTarget {
  INVOICE
  RETENTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

// An incoming payment on an issued invoice. On a credit note (Storno) a payment records the
// refund paid back to the customer.
model Payment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Documents with payments cannot be deleted (and issued ones never can anyway).
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  target PaymentTarget @default(INVOICE)
  paidAt DateTime      @db.Date
  amount Decimal       @db.Decimal(14, 2) // always positive
  method PaymentMethod @default(BANK_TRANSFER)

  reference String? // Verwendungszweck / bank reference
  note      String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([companyId, paidAt])
  @@map("payments")
}

// Escalation steps of the dunning process.
enum DunningLevel {
  REMINDER // Zahlungserinnerung (friendly, no fees)
  FIRST // 1. Mahnung
  SECOND // 2. Mahnung
  FINAL // letzte Mahnung (announces collection/legal steps)
}

// Company-wide dunning rules. One row per company, created with defaults on first use.
model DunningSettings {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reminderAfterDays Int @default(3) // days past the due date before a reminder is suggested
  graceDays         Int @default(7) // payment deadline given in every letter (days after the letter)

  feeFirst  Decimal @default(5) @db.Decimal(8, 2) // Mahngebühr per level (reminder is free)
  feeSecond Decimal @default(10) @db.Decimal(8, 2)
  feeFinal  Decimal @default(15) @db.Decimal(8, 2)

  interestEnabled Boolean @default(true)
  // Basiszinssatz of the Bundesbank (changes every 1 Jan / 1 Jul): keep it current! Default rate =
  // base + 9 points for business customers, + 5 points for consumers (§ 288 BGB).
  baseRatePercent Decimal @default(1.27) @db.Decimal(6, 3)
  lumpSumB2B      Decimal @default(40) @db.Decimal(8, 2) // Verzugspauschale § 288 Abs. 5 BGB (business customers only)

  updatedAt DateTime @updatedAt

  @@map("dunning_settings")
}

// A dunning letter that was issued for an invoice. The amounts are frozen when it is issued.
model Dunning {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  number      String? // reference number from the DUNNING number range
  level       DunningLevel
  dunningDate DateTime     @db.Date
  dueDate     DateTime     @db.Date // new payment deadline

  openAmount     Decimal @db.Decimal(14, 2) // unpaid invoice amount at that time
  feeAmount      Decimal @default(0) @db.Decimal(14, 2)
  interestRate   Decimal @default(0) @db.Decimal(6, 3) // annual rate in percent
  interestDays   Int     @default(0)
  interestAmount Decimal @default(0) @db.Decimal(14, 2)
  lumpSumAmount  Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @db.Decimal(14, 2) // open + fee + interest + lump sum

  issuerSnapshot Json
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([documentId])
  @@index([companyId, dunningDate])
  @@map("dunnings")
}

// ---------------------------------------------------------------------------------------------
// Incoming invoices (Eingangsrechnungen)
// ---------------------------------------------------------------------------------------------

enum IncomingInvoiceStatus {
  RECEIVED // Eingegangen, wartet auf Prüfung
  APPROVED // Freigegeben, kann bezahlt werden
  REJECTED // Abgelehnt (Reklamation, falscher Empfänger, ...)
  PAID // Bezahlt
}

enum IncomingInvoiceSource {
  UPLOAD // hochgeladen in der App
  EMAIL // per Mail empfangen (folgt)
  MANUAL // ohne Beleg erfasst
}

// A supplier invoice. The original file is stored unchanged (GoBD: Originalbeleg aufbewahren) and
// identified by its SHA-256 hash; the captured amounts are what the company books and pays.
model IncomingInvoice {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number String // internal running number (ER-0001), assigned on receipt

  supplierId   String?
  supplier     Contact? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String? // snapshot / free text if the supplier is not in the contacts

  invoiceNumber String? // the supplier's own invoice number
  invoiceDate   DateTime? @db.Date
  serviceDate   DateTime? @db.Date
  dueDate       DateTime? @db.Date
  description   String?   @db.Text

  netAmount     Decimal @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal @default(0) @db.Decimal(12, 2)
  grossAmount   Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("EUR")
  reverseCharge Boolean @default(false) // § 13b: no VAT shown, the company owes it

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status          IncomingInvoiceStatus @default(RECEIVED)
  source          IncomingInvoiceSource @default(UPLOAD)
  rejectionReason String?

  // Original file (stored outside the public uploads folder, served only through the API).
  filePath String?
  fileName String?
  mimeType String?
  fileSize Int?
  fileHash String? // SHA-256 hex, detects the same file uploaded twice

  uploadedById String?
  uploadedBy   User?     @relation("InvoiceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?     @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@unique([companyId, fileHash])
  @@index([companyId, status])
  @@index([projectId])
}

// ---------------------------------------------------------------------------------------------
// Dashboard
// ---------------------------------------------------------------------------------------------

// Per-user widget arrangement, stored server-side so it follows the user across devices.
// items: [{ id: "open-items", x, y, w, h }] in grid units; widgets that are not listed are hidden.
model DashboardLayout {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Json

  updatedAt DateTime @updatedAt
}
