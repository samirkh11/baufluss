// Prisma schema for the Meisterwerk platform.
//
// Multi-tenancy model: every tenant is a "Company" (= one Handwerksbetrieb / craft business).
// All tenant-owned data carries a companyId foreign key. Tenant isolation is enforced in the
// application layer (every repository/service method is called with the authenticated user's
// companyId and filters by it) rather than via Postgres Row-Level Security. RLS can be added
// later as defense-in-depth once the schema for the remaining feature blocks (contacts, projects,
// quotes, invoices, ...) has landed — see /.claude/memory/project_roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role a user holds within their company. Kept as a small enum for now; move to a dedicated
// permissions table only if/when granular per-module permissions are actually needed.
enum CompanyRole {
  OWNER // Created the company account, can manage billing and delete the company.
  ADMIN // Full access to all modules within the company.
  MEMBER // Day-to-day user; module-level restrictions can be layered on top later.
}

// A tenant: one craft business using the platform.
model Company {
  id        String  @id @default(uuid())
  name      String
  legalForm String? // e.g. "GmbH", "Einzelunternehmen"

  // Address
  street  String?
  zipCode String?
  city    String?
  country String  @default("DE")

  // Tax / banking data required on German invoices and letterhead
  taxId String? // Steuernummer
  vatId String? // USt-IdNr.
  iban  String?
  bic   String?

  // Contact details shown on documents
  email   String?
  phone   String?
  website String?

  // Branding
  logoPath             String? // relative path under /uploads served statically by the API
  letterheadHeaderText String? @db.Text
  letterheadFooterText String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  numberSequences NumberSequence[]
  contacts        Contact[]
  catalogItems    CatalogItem[]
  projects        Project[]
  reports         Report[]

  @@map("companies")
}

// A person who can log into the platform, scoped to exactly one company.
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  role         CompanyRole @default(MEMBER)
  isActive     Boolean     @default(true)
  imagePath    String? // profile picture (single image), relative path under /uploads

  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  reports            Report[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}

// Configurable numbering scheme ("Nummernkreis") for a document type, e.g. quotes or invoices.
// Only the configuration lives here for now; the counter is consumed once the corresponding
// document module (Angebote, Rechnungen, ...) is implemented.
model NumberSequence {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType  String // "QUOTE" | "ORDER" | "INVOICE" | "CREDIT_NOTE" | "REPORT" (free-form for now)
  prefix        String  @default("")
  nextNumber    Int     @default(1)
  digits        Int     @default(4) // zero-padding width, e.g. digits=4 -> "0007"
  resetYearly   Boolean @default(false)
  lastResetYear Int? // calendar year of the last yearly reset (only used when resetYearly)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentType])
  @@map("number_sequences")
}

// Business role(s) a contact plays. One contact may hold several (e.g. a supplier that is also a customer).
enum ContactType {
  CUSTOMER // Kunde
  SUPPLIER // Lieferant
  SUBCONTRACTOR // Subunternehmer
}

// Kind of catalog entry: a labour/service position or a physical article.
enum CatalogItemKind {
  SERVICE // Leistung
  ARTICLE // Artikel / Material
}

// Address book entry (customers, suppliers, subcontractors share one table because their fields
// are identical; the `types` array distinguishes the roles). Referenced by projects and documents
// in later blocks, which is why contacts are archived (isActive=false) rather than hard-deleted
// once documents exist (GoBD).
model Contact {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  types ContactType[]

  // Optional own customer/supplier number shown on documents.
  number String?

  // Organisation vs. private person
  isOrganization   Boolean @default(true)
  organizationName String? // set when isOrganization
  salutation       String? // Herr / Frau / Divers ...
  firstName        String?
  lastName         String?

  street  String?
  zipCode String?
  city    String?
  country String  @default("DE")

  email   String?
  phone   String?
  mobile  String?
  website String?

  // Tax / payment data (needed for invoices, §13b checks and incoming invoices)
  vatId           String?
  taxId           String?
  iban            String?
  bic             String?
  paymentTermDays Int? // default Zahlungsziel in Tagen

  projects Project[] // projects this contact is the customer of

  notes     String? @db.Text
  imagePath String? // single picture/logo, relative path under /uploads
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("contacts")
}

// Service and article master data ("Leistungs- und Artikelstamm"). Quote/invoice positions copy
// values from here at creation time, so later price changes never alter existing documents.
model CatalogItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind        CatalogItemKind
  sku         String? // Artikel-/Leistungsnummer
  name        String
  description String?         @db.Text
  unit        String          @default("Stk") // Einheit: Stk, h, m, m², pauschal ...

  netPrice      Decimal  @db.Decimal(12, 2) // Verkaufspreis netto
  purchasePrice Decimal? @db.Decimal(12, 2) // Einkaufspreis netto (Kalkulation)
  vatRate       Decimal  @default(19) @db.Decimal(5, 2) // Prozent

  isActive Boolean @default(true)

  images CatalogItemImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, kind])
  @@map("catalog_items")
}

// Pictures of a service/article (several per item). Tenant ownership is derived via the item.
model CatalogItemImage {
  id            String      @id @default(uuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  path          String // relative path under /uploads
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([catalogItemId])
  @@map("catalog_item_images")
}

enum ProjectStatus {
  PLANNING // In Planung
  IN_PROGRESS // In Ausführung
  ON_HOLD // Pausiert
  COMPLETED // Abgeschlossen
  CANCELLED // Abgebrochen
}

enum ReportType {
  DAILY // Tagesbericht / Bautagebuch
  PROGRESS // Baufortschrittsbericht
  DEFECT // Mängelbericht
  ACCEPTANCE // Abnahmeprotokoll
  INCIDENT // Vorkommnis / Unfall / Behinderungsanzeige
  OTHER
}

// A construction job (Bauvorhaben). The hub that quotes, orders, invoices (later blocks) and
// reports hang off.
model Project {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String // generated from the PROJECT number sequence
  name        String
  status      ProjectStatus @default(PLANNING)
  description String?       @db.Text

  // Customer is optional (early leads), but a contact that is used by a project cannot be hard-deleted.
  customerId String?
  customer   Contact? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Building site address (differs from the customer's address in most cases)
  siteStreet  String?
  siteZipCode String?
  siteCity    String?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members ProjectMember[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@map("projects")
}

// Employees assigned to a project (many-to-many).
model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// A report on a project (Bautagebuch, Mängelbericht, Abnahme, ...). Equal in rank to quotes and
// invoices: shown in the project overview next to the documents.
model Report {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number     String // generated from the REPORT number sequence
  type       ReportType @default(DAILY)
  title      String
  reportDate DateTime   @db.Date

  // Author reference plus a name snapshot, so the report stays attributable if the user is deleted.
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String

  weather         String? // free text, e.g. "sonnig, 18 °C"
  workPerformed   String? @db.Text // durchgeführte Arbeiten
  issues          String? @db.Text // Besonderheiten, Mängel, Behinderungen
  progressPercent Int? // 0-100

  photos ReportPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, reportDate])
  @@index([projectId])
  @@map("reports")
}

model ReportPhoto {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  path      String // relative path under /uploads
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_photos")
}
