# PostgreSQL connection used by Prisma. Matches the "postgres" service in docker-compose.yml.
DATABASE_URL="postgresql://meisterwerk:meisterwerk@localhost:5432/meisterwerk?schema=public"

# Secret used to sign JWT access tokens. Generate a strong random value for anything beyond local dev,
# e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="8h"

# Port the Nest HTTP server listens on.
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS). The Vite dev server runs on 5173.
CORS_ORIGINS="http://localhost:5173"
